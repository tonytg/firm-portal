# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Never commit .env.local.
#
# Also add the same three variables in Vercel:
# Project -> Settings -> Environment Variables (Production + Preview).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Grants full admin access to the database and the auth admin API.
# MUST stay server-side (used only in server actions / scripts). Never prefix
# this with NEXT_PUBLIC and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
